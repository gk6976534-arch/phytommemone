            "@media (min-width: 992px)": {
              ".card-box": {
                "padding-left": "2rem",
                "padding-right": "4rem"
              }
            },
            ".cost": {
              "color": "#819ccc"
            },
            ".card-title": {
              "text-align": "justify"
            }
